# Copy this file to .env and fill in your real values.
# .env is git-ignored and must NEVER be committed.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dayflow
DB_USER=root
DB_PASSWORD=

# Optional escape hatch: if set, this overrides everything above.
# Handy for testing before MySQL is installed, e.g.
# DATABASE_URL=sqlite:///./dayflow_dev.db
DATABASE_URL=
